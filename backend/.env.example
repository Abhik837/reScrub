# Settings for self-hosted servers (docs/DEPLOY.md) and for training (docs/TRAINING.md).
# Copy to backend/.env on each server (chmod 600; never committed) and replace every <...>.
# The local Docker stack doesn't use this file; it reads the root .env instead.

# --- Database: Tiger Cloud (DEPLOY.md §2), as the least-privilege rescrub_app user ---
DATABASE_URL=postgres://rescrub_app:<app password>@<host>:<port>/tsdb?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt

# --- Video storage: Vultr Object Storage or any S3-compatible bucket (DEPLOY.md §3) ---
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://ewr1.vultrobjects.com
S3_REGION=us-east-1
S3_BUCKET=rescrub-videos
S3_ACCESS_KEY=<access key>
S3_SECRET_KEY=<secret key>
# Delete each upload once its labeled video is saved.
DELETE_ORIGINAL_AFTER_PROCESSING=true

# --- API (web server) ---
# The site's address. Requests from any other origin are refused.
CORS_ORIGINS=https://<your-domain.com>
COOKIE_SECURE=true
SESSION_HOURS=168
# "Create account" on the website. false = only accounts made with rescrub.accounts (DEPLOY.md §6).
ALLOW_REGISTRATION=true
# Only these email domains may sign up, comma separated (e.g. school.edu). Empty = any address.
REGISTRATION_EMAIL_DOMAINS=
# Check that a new account's email domain receives mail (DNS lookup from the web server).
CHECK_EMAIL_DNS=true
MAX_UPLOAD_MB=500
MAX_VIDEO_SEC=3600
UPLOADS_PER_HOUR_PER_CLIENT=10
UPLOADS_PER_DAY_PER_USER=20
REQUESTS_PER_MINUTE_PER_CLIENT=120

# Final report by Google Gemini (key from https://aistudio.google.com). Empty = report off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
REPORTS_PER_HOUR_PER_USER=20

# --- Worker (GPU server) ---
DEVICE=auto
ENABLE_HANDS=true
ENABLE_DEPTH=true
# Trained models in models/trained/ and breach_params.json are used automatically. To choose others:
# SURFACE_CONFIG=config/surfaces.yaml   POSE_MODEL=yolo26m-pose.pt   EMBED_MODEL=yolo26n-cls.pt
# Hand-drawn sterile/non-sterile zones for a fixed camera:
# DEFAULT_ZONES_FILE=/app/config/room_zones.json

# Host folders mounted into the worker container: trained models, and the training data disk.
MODELS_HOST_DIR=./models/trained
DATA_HOST_DIR=/mnt/data
