# For `npm run dev` or a self-hosted web server: copy to .env.local (never committed).
# The local Docker stack sets these itself.

# Where the browser reaches the API: always /api on this site's own origin (Caddy routes it).
# Leave empty to run the website alone (only the demonstration works). Public: ends up in browser code.
NEXT_PUBLIC_API_BASE_URL=/api

# Server-side only: how this Next.js server reaches the API to check sign-ins before showing /review.
API_INTERNAL_URL=http://127.0.0.1:8000

# `npm run dev` only: forward /api to a backend started with
#   uvicorn rescrub.main:app --port 8000 --root-path /api
# API_DEV_PROXY=http://127.0.0.1:8000
