# Optional settings for the local Docker stack (docker-compose.local.yml). Copy to .env (never
# committed). Without a .env everything works, except the Gemini report.

# First admin account, created on the first start; its password is printed once:
#   docker compose -f docker-compose.local.yml logs init
LOCAL_ADMIN_EMAIL=admin@example.com

# "Create account" on the sign-in page. false = only accounts made with rescrub.accounts.
# ALLOW_REGISTRATION=true
# Only these email domains may sign up (comma separated). Empty = any.
# REGISTRATION_EMAIL_DOMAINS=school.edu
# New accounts' email domains are checked with DNS; turn off on a computer without internet:
# CHECK_EMAIL_DNS=false
# Recordings each account can upload per day (0 = no limit):
# UPLOADS_PER_DAY_PER_USER=20

# Final report by Google Gemini (https://aistudio.google.com → Get API key). Empty = report off.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Speed on a slow computer. Analyze every Nth frame (default 2 on CPU, 1 with the GPU override):
# FRAME_STRIDE=3
# Skip relative depth, or hand and fingertip points:
# ENABLE_DEPTH=false
# ENABLE_HANDS=false

# Public models instead of the trained ones in backend/models/trained
# (yolo26n-pose.pt is a much faster pose model for a slow computer):
# SURFACE_CONFIG=config/surfaces.yaml
# POSE_MODEL=yolo26m-pose.pt
# EMBED_MODEL=yolo26n-cls.pt
